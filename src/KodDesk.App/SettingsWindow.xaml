<Window x:Class="KodDesk.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/KodDesk;component/Assets/kod-desk.ico"
        Title="Setări — KodDesk" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="ServiceHeader" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Setările serviciului KodDesk (se aplică după repornirea automată a serviciului)."/>

        <Border x:Name="RelayCard" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="SERVER RELAY"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Adresă (ex. wss://kod-desk.exemplu.ro)"/>
                <TextBox x:Name="RelayAddressBox"/>
                <TextBlock Style="{StaticResource Label}" Text="Cheie relay"/>
                <PasswordBox x:Name="RelayKeyBox"/>
            </StackPanel>
        </Border>

        <Border x:Name="PasswordCard" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="PAROLĂ PENTRU ACCES LA ACEST CALCULATOR"/>
                <TextBlock x:Name="PasswordHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Label}" Text="Parolă nouă (minim 8 caractere)"/>
                <PasswordBox x:Name="NewPasswordBox"/>
                <TextBlock Style="{StaticResource Label}" Text="Confirmare parolă"/>
                <PasswordBox x:Name="ConfirmPasswordBox"/>
                <CheckBox x:Name="RemovePasswordCheck" Content="Elimină parola (dezactivează accesul)" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="QualityCard" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="CALITATE (CÂND CONTROLAȚI ALT CALCULATOR)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Bitrate maxim"/>
                        <ComboBox x:Name="BitrateBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Cadre pe secundă"/>
                        <ComboBox x:Name="FpsBox"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ViewerModeHint" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Parola pentru accesul la acest calculator se modifică din fereastra principală → „Setări serviciu”."/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Anulează" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Salvează" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
