<Window x:Class="KodDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/KodDesk;component/Assets/kod-desk.ico"
        Title="KodDesk" Width="800" Height="560" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <DockPanel Margin="20">
        <!-- Banner: acest calculator este controlat -->
        <Border x:Name="ControlledBanner" DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Deconectează" Style="{StaticResource SecondaryButton}" Click="DisconnectIncoming_Click"/>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#92400E"
                           Text="Acest calculator este controlat de la distanță."/>
            </DockPanel>
        </Border>

        <!-- Subsol -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Setări" Style="{StaticResource SecondaryButton}" Click="Settings_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Se conectează..." TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Acest calculator -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="ACEST CALCULATOR"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0,4,0,2" Text="ID-ul dvs."/>
                    <TextBlock x:Name="MyIdText" FontSize="34" FontWeight="SemiBold" Text="--- --- ---"
                               Cursor="Hand" ToolTip="Clic pentru a copia" MouseLeftButtonUp="MyId_Click"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,16,0,4" Text="Acces nesupravegheat"/>
                    <TextBlock x:Name="PasswordStateText" TextWrapping="Wrap"/>
                    <Button x:Name="PasswordButton" Content="Setează parola..." HorizontalAlignment="Left" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButton}" Click="PasswordButton_Click"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,16,0,4" Text="Serviciu Windows"/>
                    <TextBlock x:Name="ServiceStateText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Controlează alt calculator -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="CONTROLEAZĂ ALT CALCULATOR"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0,4,0,4" Text="ID calculator"/>
                    <ComboBox x:Name="RemoteIdBox" IsEditable="True" FontSize="18" KeyDown="ConnectField_KeyDown"
                              SelectionChanged="RemoteIdBox_Changed" TextBoxBase.TextChanged="RemoteIdBox_Changed"/>
                    <TextBlock Style="{StaticResource Label}" Text="Parolă"/>
                    <PasswordBox x:Name="RemotePasswordBox" FontSize="16" KeyDown="ConnectField_KeyDown"/>
                    <TextBlock x:Name="SavedPasswordHint" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                               Text="Parolă memorată — puteți lăsa câmpul gol." Visibility="Collapsed"/>
                    <CheckBox x:Name="RememberCheck" Content="Memorează parola" Margin="0,10,0,0"/>
                    <Button x:Name="ConnectButton" Content="Conectare" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                    <TextBlock x:Name="ConnectErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
