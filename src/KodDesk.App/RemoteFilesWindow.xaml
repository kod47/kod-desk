<Window x:Class="KodDesk.App.RemoteFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/KodDesk;component/Assets/kod-desk.ico"
        Title="Fișiere la distanță — KodDesk" Width="920" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Locuri" ToolTip="Desktop, Descărcări, Documente și unități" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,6,0" Click="Home_Click"/>
                <Button Content="↑" ToolTip="Folderul părinte (Backspace)" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Up_Click"/>
                <Button Content="⟳" ToolTip="Reîncarcă (F5)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Refresh_Click"/>
            </StackPanel>
            <TextBox x:Name="PathBox" KeyDown="PathBox_KeyDown" ToolTip="Scrieți o cale și apăsați Enter"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="UploadButton" Content="Încarcă aici..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Upload_Click"/>
                <Button x:Name="DownloadButton" Content="Descarcă selecția..." Style="{StaticResource PrimaryButton}" Click="Download_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <ItemsControl x:Name="TransfersList" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                      ItemTemplate="{StaticResource TransferTemplate}" Focusable="False"/>

        <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Sfat: trageți fișiere din Explorer în listă pentru a le încărca în folderul deschis, sau din listă în Explorer pentru a le descărca."/>

        <ListView x:Name="List" SelectionMode="Extended" AllowDrop="True" BorderBrush="{StaticResource BorderBrush}"
                  MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                  DragEnter="List_DragOver" DragOver="List_DragOver" Drop="List_Drop"
                  PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nume" Width="480">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Width="22" FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Mărime" Width="120" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modificat" Width="170" DisplayMemberBinding="{Binding DateText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
