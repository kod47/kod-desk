<Window x:Class="KodDesk.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/KodDesk;component/Assets/kod-desk.ico"
        Title="KodDesk" Width="1280" Height="800" Background="Black"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Toolbar" Background="#1F2937" Padding="8,5" MouseLeave="Toolbar_MouseLeave">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="StatsText" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Ctrl+Alt+Del" Style="{StaticResource ToolbarButton}" Click="CtrlAltDel_Click"
                            ToolTip="Trimite Ctrl+Alt+Del (necesită serviciul KodDesk pe calculatorul la distanță)"/>
                    <Button x:Name="FullscreenButton" Content="Ecran complet" Style="{StaticResource ToolbarButton}" Click="Fullscreen_Click"/>
                    <Button Content="Deconectare" Style="{StaticResource ToolbarButton}" Foreground="#FCA5A5" Click="Disconnect_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <ComboBox x:Name="MonitorBox" MinWidth="160" SelectionChanged="MonitorBox_SelectionChanged" ToolTip="Monitor"/>
                    <ComboBox x:Name="QualityBox" MinWidth="120" SelectionChanged="QualityBox_SelectionChanged" ToolTip="Bitrate maxim"/>
                    <Button x:Name="ScaleButton" Content="Mărime reală (1:1)" Style="{StaticResource ToolbarButton}" Click="Scale_Click"/>
                    <Button x:Name="FilesButton" Content="Fișiere ▾" Style="{StaticResource ToolbarButton}" Click="FilesButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Trimite fișiere pe Desktop-ul de la distanță..." Click="SendFiles_Click"/>
                                <MenuItem Header="Trimite un folder pe Desktop-ul de la distanță..." Click="SendFolder_Click"/>
                                <MenuItem Header="Explorator fișiere la distanță..." Click="RemoteExplorer_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ClipboardMenu" Header="Sincronizează clipboard-ul (Ctrl+C / Ctrl+V)"
                                          IsCheckable="True" IsChecked="True" Click="ClipboardMenu_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False" Background="Black" AllowDrop="True"
                      DragEnter="Screen_DragOver" DragOver="Screen_DragOver" DragLeave="Screen_DragLeave" Drop="Screen_Drop"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <Image x:Name="Screen" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Arrow"
                   MouseMove="Screen_MouseMove" MouseDown="Screen_MouseDown" MouseUp="Screen_MouseUp" MouseWheel="Screen_MouseWheel"/>
        </ScrollViewer>

        <TextBlock x:Name="Overlay" Grid.Row="1" Text="Se așteaptă imaginea..." Foreground="#9CA3AF" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>

        <!-- Indicator la tragerea fișierelor peste fereastră -->
        <Border x:Name="DropHint" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#802563EB" BorderBrush="#60A5FA" BorderThickness="3">
            <Border Background="#E61F2937" CornerRadius="10" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Foreground="White" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                           Text="Lăsați fișierele aici&#x0a;pentru a le trimite pe Desktop-ul de la distanță"/>
            </Border>
        </Border>

        <!-- Transferuri în curs -->
        <ItemsControl x:Name="TransfersList" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                      ItemTemplate="{StaticResource TransferTemplate}" Focusable="False"/>

        <!-- În modul ecran complet, bara apare când mouse-ul atinge marginea de sus -->
        <Border x:Name="HoverStrip" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Height="4"
                Background="#01000000" Visibility="Collapsed" MouseEnter="HoverStrip_MouseEnter"/>
    </Grid>
</Window>
